<?xml version="1.0" encoding="UTF-8"?>
<package xmlns="http://expath.org/ns/pkg" name="${package-name}" abbrev="${package-abbrev}" version="${project.version}"
    spec="1.0">
    <title>${package-title}</title>
    <author id="bcdh">Belgrade Center for Digital Humanities</author>
    <website>${project.url}</website>
    <license>GNU General Public License, version 2</license>
    <copyright>true</copyright>

    <type>library</type>

    <status>stable</status>

    <tag>${project.artifactId}</tag>
    <tag>library</tag>
    <category id="libs">Libraries</category>

    <dependency processor="http://elemental.xyz" semver-min="6.4.0" />
    <dependency processor="http://exist-db.org" semver-min="6.3.0" />

    <!-- include the XQuery Library Module written in Java (JAR output) from this project -->
    <dependencySets>
        <dependencySet>
            <groupId>${project.groupId}</groupId>
            <artifactId>${project.artifactId}</artifactId>
            <version>${project.version}</version>
        </dependencySet>
        <dependencySet>
            <groupId>com.evolvedbinary.cql</groupId>
            <artifactId>corpusql-parser</artifactId>
            <version>${corpusql-parser.version}</version>
        </dependencySet>
        <dependencySet>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr.version}</version>
        </dependencySet>
    </dependencySets>

    <!-- register the Java module -->
    <components>
        <resource>
            <public-uri>${cql.module.namespace}</public-uri>
            <file>urn:java:class:${java-package-name}.${java-package-main-class-name}</file>
        </resource>
    </components>

</package>
